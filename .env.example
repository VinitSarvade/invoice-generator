# Invoice Generator - Environment Variables
# Copy this file to .env.local and fill in your values

# ===================================
# Required in Production
# ===================================

# Application URL (required for auth callbacks and email links)
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# Better Auth Secret (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=your-secret-key-here-change-this-in-production

# ===================================
# Email Configuration (Optional)
# ===================================

# SMTP Settings for sending invoices
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
SMTP_SECURE=false
SMTP_FROM=noreply@yourcompany.com

# ===================================
# Feature Flags (Optional)
# ===================================

# Enable/disable email functionality
ENABLE_EMAIL=true

# Enable/disable analytics dashboard
ENABLE_ANALYTICS=true

# Enable/disable advanced search
ENABLE_SEARCH=true

# Require authentication for all API routes (recommended for production)
REQUIRE_AUTH=false

# Enable rate limiting on API routes
ENABLE_RATE_LIMITING=false

# ===================================
# Application Configuration (Optional)
# ===================================

# Maximum number of line items per invoice
MAX_INVOICE_ITEMS=500

# Session expiry in days
SESSION_EXPIRY_DAYS=7

# Minimum password length
MIN_PASSWORD_LENGTH=8

# Default currency code
DEFAULT_CURRENCY_CODE=USD

# ===================================
# Logging & Monitoring (Optional)
# ===================================

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Enable detailed API logging
ENABLE_API_LOGGING=false

# ===================================
# Database (Auto-configured)
# ===================================

# SQLite database path (default: sqlite.db in project root)
DATABASE_PATH=./sqlite.db

# ===================================
# Development Only
# ===================================

# Disable SSL in development
NODE_TLS_REJECT_UNAUTHORIZED=0

# Next.js telemetry
NEXT_TELEMETRY_DISABLED=1
